# Raw scrape cache — regenerated by the ETL, never committed
data/raw/

# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/

# Node
node_modules/
web/dist/
.vite/

# Staged at build time by web/scripts/stage-data.mjs (npm `prebuild`), and
# symlinked at data/processed during local dev by `npm run link-data`. Never
# committed — data/processed is the single source of truth.
# No trailing slash: during local dev this path is a SYMLINK, not a directory,
# and a trailing slash would match only the directory form and commit the link.
web/public/data

# Vercel CLI local state
.vercel/

# OS / editor
.DS_Store
.idea/
.vscode/
.gstack/
